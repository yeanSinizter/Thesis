{
  "dataset_path": "dataset.json",
  "runs_per_condition": 30,
  "max_iterations": 5,
  "secure_prompt_version": "v2",
  "merge_replace_feedback_strategies": [
    "iterative_placebo_feedback"
  ],
  "placebo_feedback": {
    "mode": "shuffled_findings",
    "seed": 42,
    "description": "Same loop as iterative_static_feedback but feedback JSON is shuffled/misaligned real findings (not code-aligned scanner semantics)."
  },
  "candidate_selection": {
    "enabled": true,
    "num_candidates": 3,
    "target_prompt_strategies": [
      "security_enhanced"
    ],
    "target_feedback_strategies": [
      "none",
      "iterative_placebo_feedback"
    ]
  },
  "repair_candidate_selection": {
    "enabled": true,
    "num_candidates": 3,
    "reject_on_regression": true
  },
  "prompt_strategies": [
    "security_enhanced"
  ],
  "feedback_strategies": [
    "iterative_placebo_feedback"
  ],
  "models": [
    {
      "id": "ollama_qwen2_5_coder_7b",
